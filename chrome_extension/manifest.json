{
    "manifest_version": 3,

    "name": "Latvian Email Security",

    "version": "1.0",

    "description": "Latvian phishing email detector",

    "permissions": [
        "activeTab",
        "storage",
        "scripting"
    ],

    "host_permissions": [
        "http://127.0.0.1:5000/*",
        "https://mail.google.com/*"
    ],

    "action": {
        "default_popup": "popup.html"
    },

    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "matches": [
                "https://mail.google.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}